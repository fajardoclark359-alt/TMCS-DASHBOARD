# Advance Ultimate OSINT Tools - Production Environment Variables
# Copy to .env and fill in your values

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
DATABASE_URL=postgresql+asyncpg://auosint:changeme@postgres:5432/auosint
POSTGRES_PASSWORD=changeme

# ===========================================
# REDIS (Celery Broker)
# ===========================================
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# Generate with: openssl rand -hex 32
API_KEY=your-secure-api-key-here
JWT_SECRET=your-jwt-secret-here
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ===========================================
# CORS & ORIGINS
# ===========================================
ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ===========================================
# EXTERNAL API KEYS (Optional - for enhanced OSINT)
# ===========================================
# Shodan: https://account.shodan.io/
SHODAN_API_KEY=

# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# Censys: https://censys.io/account/api
CENSYS_API_ID=
CENSYS_API_SECRET=

# GreyNoise: https://app.greynoise.io/account
GREYNOISE_API_KEY=

# AlienVault OTX: https://otx.alienvault.com/api
OTX_API_KEY=

# HaveIBeenPwned: https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# AbuseIPDB: https://www.abuseipdb.com/api.html
ABUSEIPDB_API_KEY=

# ===========================================
# PH BREACH ALERTS
# ===========================================
BREACH_ALERT_DIR=/app/breach_alerts

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_DEFAULT=30/minute
RATE_LIMIT_SEARCH=10/minute

# ===========================================
# FILE UPLOAD
# ===========================================
MAX_UPLOAD_BYTES=26214400

# ===========================================
# SSRF PROTECTION (set to true only for lab environments)
# ===========================================
ALLOW_PRIVATE_TARGETS=false

# ===========================================
# FRONTEND (Vite build-time variable)
# ===========================================
VITE_API_URL=https://api.your-domain.com
# Must match API_KEY above when API-key auth is enabled
VITE_API_KEY=your-secure-api-key-here
