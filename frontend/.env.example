# Leave unset for local dev (vite proxy) and docker (nginx proxy).
# For GitHub Pages or any separately hosted backend:
# VITE_API_URL=https://your-backend-host:8000
# Must match the backend's API_KEY when API-key auth is enabled:
# VITE_API_KEY=your-api-key-here

# Facebook Graph API token for page monitoring (DarkWebMonitor)
# Get a token from https://developers.facebook.com/tools/explorer/
VITE_FB_ACCESS_TOKEN=
